set_global_assignment -name TOP_LEVEL_ENTITY sys_top
# Combined analog and HDMI output is the first candidate. Split outputs only
# if measured FPGA fitting/timing results justify the additional variants.
source PSX.qsf
set_global_assignment -name VERILOG_MACRO "PSX_HQ2X=1"

set_instance_assignment -name MAX_FANOUT 16 -to "ascal|o_v_poly_use_adaptive"
set_instance_assignment -name IGNORE_LCELL_BUFFERS OFF -to "emu|psx|ipsx_top|imemorymux|iwritefifo"

# Reproducible build invocation overrides.
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"